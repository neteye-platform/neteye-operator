{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["github>neteye-platform/repo-commons"],
  "description": "Commits by the bot that regenerates the OLM bundle (regenerate-bundle workflow) must not make Renovate treat its pull requests as manually edited",
  "gitIgnoredAuthors": ["265889471+neteye-steward[bot]@users.noreply.github.com"],
  "packageRules": [
    {
      "description": "Do not pin the OperatorHub catalog digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["quay.io/operatorhubio/catalog"],
      "pinDigests": false,
      "minimumReleaseAge": null
    },
    {
      "description": "Do not pin the Neteye Operator catalog digest",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/neteye-platform/neteye-catalog"],
      "pinDigests": false,
      "minimumReleaseAge": null
    },
    {
      "description": "One pull request per operand image: the Keycloak image is updated in every place it is referenced so the copies cannot drift (overrides the shared digest grouping)",
      "matchDatasources": ["docker"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["src/api/v1alpha1/neteyeconfig_types.go", "src/config/manifests/patches/deployment.yaml", "src/config/manifests/patches/metadata.yaml"],
      "matchPackageNames": ["ghcr.io/neteye-platform/neteye-keycloak"],
      "groupName": "Keycloak operand image"
    },
    {
      "description": "One pull request per operand image: the OpenTelemetry collector image is updated in every place it is referenced so the copies cannot drift (overrides the shared digest grouping)",
      "matchDatasources": ["docker"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["src/api/v1alpha1/neteyeconfig_types.go", "src/config/manifests/patches/deployment.yaml", "src/config/manifests/patches/metadata.yaml"],
      "matchPackageNames": ["docker.io/otel/opentelemetry-collector-contrib"],
      "groupName": "OpenTelemetry collector operand image"
    },
    {
      "description": "One pull request per operand image: the EDOT gateway image is updated in every place it is referenced so the copies cannot drift (overrides the shared digest grouping)",
      "matchDatasources": ["docker"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["src/api/v1alpha1/neteyeconfig_types.go", "src/config/manifests/patches/deployment.yaml", "src/config/manifests/patches/metadata.yaml"],
      "matchPackageNames": ["docker.elastic.co/elastic-agent/elastic-otel-collector"],
      "groupName": "EDOT gateway operand image"
    },
    {
      "description": "One pull request per operand image: the CA bundle image is updated in every place it is referenced so the copies cannot drift (overrides the shared digest grouping)",
      "matchDatasources": ["docker"],
      "matchManagers": ["custom.regex"],
      "matchFileNames": ["src/api/v1alpha1/neteyeconfig_types.go", "src/config/manifests/patches/deployment.yaml", "src/config/manifests/patches/metadata.yaml"],
      "matchPackageNames": ["docker.io/alpine"],
      "groupName": "CA bundle operand image"
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Operand images in the NetEye component defaults",
      "managerFilePatterns": ["src/api/v1alpha1/neteyeconfig_types.go"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "Image:\\s*\"(?<depName>[^\"@:]+):(?<currentValue>[^\"@]+?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?\""
      ],
      "autoReplaceStringTemplate": "Image: \"{{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}\""
    },
    {
      "customType": "regex",
      "description": "Operand images advertised as RELATED_IMAGE_* in the CSV deployment patch",
      "managerFilePatterns": ["src/config/manifests/patches/deployment.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "value:\\s*(?<depName>[^\\s@:,]+):(?<currentValue>[^\\s@,]+?)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?,"
      ],
      "autoReplaceStringTemplate": "value: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}},"
    },
    {
      "customType": "regex",
      "description": "Operand images listed as relatedImages in the CSV metadata patch",
      "managerFilePatterns": ["src/config/manifests/patches/metadata.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "image:\\s*(?<depName>[^\\s@:]+):(?<currentValue>[^\\s@]+)(?:@(?<currentDigest>sha256:[a-f0-9]{64}))?"
      ],
      "autoReplaceStringTemplate": "image: {{{depName}}}:{{{newValue}}}{{#if newDigest}}@{{{newDigest}}}{{/if}}"
    },
    {
      "customType": "regex",
      "description": "opm image used to validate the generated catalog",
      "managerFilePatterns": [".github/workflows/release.yaml"],
      "datasourceTemplate": "docker",
      "matchStrings": [
        "\"(?<depName>quay\\.io/operator-framework/opm):(?<currentValue>[^\"@]+)@(?<currentDigest>sha256:[a-f0-9]{64})\""
      ]
    },
    {
      "customType": "regex",
      "description": "OLM release repackaged as a Helm chart",
      "managerFilePatterns": [".github/workflows/publish-olm-chart.yaml"],
      "datasourceTemplate": "github-releases",
      "depNameTemplate": "operator-framework/operator-controller",
      "matchStrings": [
        "default:\\s*\"(?<currentValue>v[\\d.]+)\"",
        "inputs\\.olm_version\\s*\\|\\|\\s*'(?<currentValue>v[\\d.]+)'"
      ]
    }
  ]
}
